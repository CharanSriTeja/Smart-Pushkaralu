# Mobile Environment Configuration (Expo)

# Production or Staging API URL (must be https:// in production)
EXPO_PUBLIC_API_URL=

# Error Reporting (Optional)
EXPO_PUBLIC_SENTRY_DSN=

# Firebase Web Client Configuration (Optional for native build, read from google-services.json if omitted)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
