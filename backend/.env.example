# Port the backend server listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# PostgreSQL connection pool URL (Local Postgres or Neon Serverless)
# NOTE: If using Neon, do NOT include channel_binding=require because node-postgres does not support SCRAM channel binding.
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret key for signing 15-minute access tokens (minimum 16 chars)
JWT_SECRET=smart-pushkaralu-super-secret-jwt-key-2027

# Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Comma-separated list of admin phone numbers in E.164 format (e.g. +919876543210,+919999999999)
ADMIN_PHONES=+919876543210,+919999999999

# CORS allowed origins (comma-separated, e.g. Vite admin panel, Expo Web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000

# Feature Flag: ICCC Integration (false by default)
ICCC_ENABLED=false

# Monthly free tier quota for external APIs (e.g. Maps/SMS)
MONTHLY_API_FREE_QUOTA=10000

# Sentry DSN for error reporting (optional)
SENTRY_DSN=

# Pino structured log level (info, debug, warn, error)
LOG_LEVEL=info

# --- Module 5: Nearby Places & Hotels Configuration ---
# Google Places API Key (optional; deterministic curated places served if absent)
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_EXPIRY_DAYS=7
PLACES_API_DAILY_LIMIT=500
SPEED_FACTOR_DRIVING_KMH=15
SPEED_FACTOR_WALKING_KMH=4.5

# --- Module 7: Emergency SOS Configuration ---
# National Emergency Default Helpline (Default: 112)
SOS_DEFAULT_NUMBER=112

# SMS Gateway Provider Adapter (mock | generic)
SOS_SMS_GATEWAY_ADAPTER=mock

# Shared Webhook Secret used to authenticate SMS Gateway incoming webhooks
SOS_WEBHOOK_SECRET=dev-sos-webhook-secret-key-32chars

# Public Base URL for generated QR Zone Posters (points to static SOS page)
SOS_WEB_BASE_URL=http://localhost:4000

# On-Duty District Admin Backup Phone for Critical Push/SMS Fallbacks
SOS_BACKUP_NOTIFY_PHONE=+919876543210

# SOS Rate Limits & Thresholds
SOS_RATE_LIMIT_PER_HOUR=10
SOS_DEDUP_WINDOW_MINUTES=5
SOS_CLUSTER_THRESHOLD=5
SOS_CLUSTER_WINDOW_MINUTES=10
