# Port the backend server listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# PostgreSQL connection pool URL (Local Postgres or Neon Serverless)
# NOTE: If using Neon, do NOT include channel_binding=require because node-postgres does not support SCRAM channel binding.
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret key for signing 15-minute access tokens (minimum 16 chars)
JWT_SECRET=smart-pushkaralu-super-secret-jwt-key-2027

# Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Comma-separated list of admin phone numbers in E.164 format (e.g. +919876543210,+919999999999)
ADMIN_PHONES=+919876543210,+919999999999
