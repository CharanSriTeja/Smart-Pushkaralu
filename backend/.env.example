# Backend API Environment Configuration (Node.js / Express / TypeScript)

# Server Environment & Port
PORT=
NODE_ENV=

# Database URLs (PostgreSQL with PostGIS on Neon)
# Runtime pooled connection URL (with sslmode=require)
DATABASE_URL=
# Direct unpooled connection URL for running migrations and DDL
MIGRATION_DATABASE_URL=

# Security & Authentication
# 64-character random string for signing JWT tokens
JWT_SECRET=
# Upload authentication secret (min 32 chars)
UPLOAD_SECRET=
# Comma-separated list of admin phone numbers in E.164 format (e.g. +919876543210,+919999999999)
ADMIN_PHONES=
# Comma-separated list of allowed CORS origins (must match Admin and Mobile URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000,https://smart-pushkaralu.vercel.app

# Firebase Admin Credentials
# Path to service account JSON file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Raw or base64-encoded service account JSON string (recommended for cloud hosts like Render)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Object Storage for Uploads (cloudinary | firebase | s3 | local)
# Note: 'local' is permitted in development only; production requires cloud object storage
STORAGE_ADAPTER=
# Cloudinary settings (when STORAGE_ADAPTER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3 settings (when STORAGE_ADAPTER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
# Firebase Storage bucket (when STORAGE_ADAPTER=firebase)
FIREBASE_STORAGE_BUCKET=

# Background Scheduler & Cron
# Set to 'true' to run in-process scheduled jobs (news expiry, cache prewarm)
ENABLE_SCHEDULER=

# Module 2: Routing Provider & Keys (ors | osrm)
ROUTING_PROVIDER=
ORS_API_KEY=
OPENROUTESERVICE_API=
OSRM_BASE_URL=

# Module 5: Nearby Places & Distance
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_EXPIRY_DAYS=
PLACES_API_DAILY_LIMIT=
SPEED_FACTOR_DRIVING_KMH=
SPEED_FACTOR_WALKING_KMH=

# Module 7: Emergency SOS Configuration
SOS_DEFAULT_NUMBER=
# SMS Gateway adapter: 'generic' in production, 'mock' in development only
SOS_SMS_GATEWAY_ADAPTER=
# Secret for HMAC verification of SMS webhook delivery reports
SOS_WEBHOOK_SECRET=
# Public base URL for generated QR Zone Posters
SOS_WEB_BASE_URL=
# Fallback notification phone for critical SOS escalation
SOS_BACKUP_NOTIFY_PHONE=
SOS_RATE_LIMIT_PER_HOUR=
SOS_DEDUP_WINDOW_MINUTES=
SOS_CLUSTER_THRESHOLD=
SOS_CLUSTER_WINDOW_MINUTES=

# Platform & Monitoring
ICCC_ENABLED=
MONTHLY_API_FREE_QUOTA=
SENTRY_DSN=
LOG_LEVEL=

# Development-only flags (MUST be false or unset in production)
ALLOW_DEV_AUTH=
SEED_DEMO=
